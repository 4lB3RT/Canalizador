# Plantilla del .env de producción.
# Copiar a .env.vault y cifrar con Ansible Vault:
#
#   cp docker/prod/.env.template docker/prod/.env.vault
#   # editar con valores reales
#   ansible-vault encrypt docker/prod/.env.vault
#
# La passphrase debe coincidir con el secret ANSIBLE_VAULT_PASSWORD de GitHub.

APP_NAME=Helmreel
APP_ENV=production
APP_KEY=                       # generar con: php artisan key:generate --show
APP_DEBUG=false
# Pre-dominio: APP_URL=http://34.140.147.18
# Con dominio: APP_URL=https://helmreel.com
APP_URL=http://34.140.147.18

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de datos (MySQL dentro de docker compose, hostname = nombre servicio)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=helmreel
DB_USERNAME=root
DB_PASSWORD=                   # debe coincidir con MYSQL_ROOT_PASSWORD

MYSQL_DATABASE=helmreel
MYSQL_ROOT_PASSWORD=           # mismo valor que DB_PASSWORD

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Cache & queue
CACHE_STORE=redis
QUEUE_CONNECTION=rabbitmq
SESSION_DRIVER=redis

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

# Filesystem
FILESYSTEM_DISK=public

# Google OAuth
# ⚠️ Google NO acepta IPs en redirect URIs — dejar vacío hasta tener dominio.
# Una vez tengas dominio, añadirlo también en https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_ANALYTICS_CLIENT_ID=
YOUTUBE_ANALYTICS_CLIENT_SECRET=
# Backend OAuth callback. Con dominio: https://helmreel.com/auth/google/callback
YOUTUBE_ANALYTICS_REDIRECT_URI=
# Base del SPA al que el callback devuelve el token (sin barra final).
# El controller redirige a <FRONTEND_REDIRECT_URI>/auth/callback#token=...
# Con dominio: https://helmreel.com
FRONTEND_REDIRECT_URI=

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_LIGHT=gpt-5-mini
PRISM_REQUEST_TIMEOUT=120

# Google Veo
GOOGLE_VEO_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
VEO_DURATION=8
VEO_RESOLUTION=720p
VEO_ASPECT_RATIO=16:9
VEO_POLLING_INTERVAL=5
VEO_POLLING_MAX_ATTEMPTS=120

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_sts_v2

# AEMET
AEMET_API_KEY=

# Backups
BACKUPS_BUCKET=helmreel-backups
GCP_REGION=europe-west1
